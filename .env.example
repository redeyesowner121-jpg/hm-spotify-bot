# ─────────────────────────────────────────────────────────
#  H&M + Spotify Telegram Bot — Environment Configuration
# ─────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather

# Your Telegram user ID (comma-separated for multiple users)
# Find yours by messaging @userinfobot on Telegram
AUTHORIZED_USER_IDS=6898461453

# ── Security ──────────────────────────────────────────────
# Fernet encryption key for credential/session storage
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Database ──────────────────────────────────────────────
DATABASE_PATH=data/bot.db

# ── Browser ───────────────────────────────────────────────
# true = headless (no visible window, for server/VPS/Railway)
# false = headed (visible window, for local desktop)
BROWSER_HEADLESS=true

# ── H&M ──────────────────────────────────────────────────
HM_BASE_URL=https://www2.hm.com

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
